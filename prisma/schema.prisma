generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Identity and Access Management
// -----------------------------------------------------------------------------

model Person {
  id                   String    @id @default(uuid()) @db.Uuid
  displayName          String    @map("display_name") @db.VarChar(200)
  status               String    @map("status") @db.VarChar(30)
  mergedIntoPersonId   String?   @map("merged_into_person_id") @db.Uuid
  lastActivityAt       DateTime? @map("last_activity_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdByPersonId    String?   @map("created_by_person_id") @db.Uuid
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedByPersonId    String?   @map("updated_by_person_id") @db.Uuid
  rowVersion           BigInt    @default(1) @map("row_version")

  // Relations
  authIdentities       AuthIdentity[]
  authSessions         AuthSession[]
  workspaceMemberships WorkspaceMembership[]
  projectAssignments   ProjectAssignment[]
  runAssignments       RunAssignment[]
  phaseAssignments     PhaseAssignment[]
  runParticipations    RunParticipation[]
  phaseParticipations  PhaseParticipation[]
  handoverParticipants HandoverParticipant[]

  @@map("IBOT_person")
}

model AuthIdentity {
  id                        String    @id @default(uuid()) @db.Uuid
  personId                  String    @map("person_id") @db.Uuid
  providerType              String    @map("provider_type") @db.VarChar(30) // LOCAL, OIDC, SAML, OTHER
  providerName              String    @map("provider_name") @db.VarChar(80)
  providerSubject           String?   @map("provider_subject") @db.VarChar(320)
  loginIdentifierNormalized String?   @unique @map("login_identifier_normalized") @db.VarChar(320)
  passwordHash              String?   @map("password_hash") @db.Text
  status                    String    @map("status") @db.VarChar(30)
  emailVerifiedAt           DateTime? @map("email_verified_at") @db.Timestamptz
  failedLoginCount          Int       @default(0) @map("failed_login_count")
  lockedUntil               DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt               DateTime? @map("last_login_at") @db.Timestamptz
  disabledAt                DateTime? @map("disabled_at") @db.Timestamptz
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdByPersonId         String?   @map("created_by_person_id") @db.Uuid
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedByPersonId         String?   @map("updated_by_person_id") @db.Uuid
  rowVersion                BigInt    @default(1) @map("row_version")

  person                    Person        @relation(fields: [personId], references: [id])
  sessions                  AuthSession[]

  @@map("IBOT_auth_identity")
}

model AuthSession {
  id                   String    @id @default(uuid()) @db.Uuid
  authIdentityId       String    @map("auth_identity_id") @db.Uuid
  personId             String    @map("person_id") @db.Uuid
  deviceRegistrationId String?   @map("device_registration_id") @db.Uuid
  sessionTokenHash     String?   @map("session_token_hash") @db.VarChar(256)
  refreshTokenHash     String?   @unique @map("refresh_token_hash") @db.VarChar(256)
  ipAddress            String?   @map("ip_address") @db.Inet
  userAgent            String?   @map("user_agent") @db.Text
  issuedAt             DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz
  lastSeenAt           DateTime? @map("last_seen_at") @db.Timestamptz
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason         String?   @map("revoke_reason") @db.VarChar(240)

  authIdentity         AuthIdentity @relation(fields: [authIdentityId], references: [id])
  person               Person       @relation(fields: [personId], references: [id])

  @@map("IBOT_auth_session")
}

model Workspace {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceType     String    @map("workspace_type") @db.VarChar(30) // OTTOBON, ORGANIZATION, INDIVIDUAL
  displayName       String    @map("display_name") @db.VarChar(200)
  ownerPersonId     String?   @map("owner_person_id") @db.Uuid
  status            String    @map("status") @db.VarChar(30)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdByPersonId String?   @map("created_by_person_id") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedByPersonId String?   @map("updated_by_person_id") @db.Uuid
  rowVersion        BigInt    @default(1) @map("row_version")

  memberships       WorkspaceMembership[]
  organization      Organization?

  @@map("IBOT_workspace")
}

model WorkspaceMembership {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  personId          String    @map("person_id") @db.Uuid
  status            String    @map("status") @db.VarChar(30)
  joinedAt          DateTime? @map("joined_at") @db.Timestamptz
  suspendedAt       DateTime? @map("suspended_at") @db.Timestamptz
  endedAt           DateTime? @map("ended_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdByPersonId String?   @map("created_by_person_id") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedByPersonId String?   @map("updated_by_person_id") @db.Uuid
  rowVersion        BigInt    @default(1) @map("row_version")

  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  person            Person    @relation(fields: [personId], references: [id])

  @@map("IBOT_workspace_membership")
}

// -----------------------------------------------------------------------------
// Core Product Domain
// -----------------------------------------------------------------------------

model Organization {
  id                   String    @id @default(uuid()) @db.Uuid
  workspaceId          String    @unique @map("workspace_id") @db.Uuid
  organizationType     String    @map("organization_type") @db.VarChar(30) // ENTERPRISE, ACADEMY
  organizationCode     String    @map("organization_code") @db.VarChar(80)
  legalName            String?   @map("legal_name") @db.VarChar(240)
  displayName          String    @map("display_name") @db.VarChar(240)
  slug                 String    @unique @db.VarChar(160)
  status               String    @map("status") @db.VarChar(30)
  countryCode          String?   @map("country_code") @db.Char(2)
  timezone             String    @db.VarChar(80)
  defaultCurrency      String?   @map("default_currency") @db.Char(3)
  dataRegion           String?   @map("data_region") @db.VarChar(80)
  approvedAt           DateTime? @map("approved_at") @db.Timestamptz
  approvedByPersonId   String?   @map("approved_by_person_id") @db.Uuid
  suspendedAt          DateTime? @map("suspended_at") @db.Timestamptz
  suspendedByPersonId  String?   @map("suspended_by_person_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdByPersonId    String?   @map("created_by_person_id") @db.Uuid
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedByPersonId    String?   @map("updated_by_person_id") @db.Uuid
  rowVersion           BigInt    @default(1) @map("row_version")

  workspace            Workspace @relation(fields: [workspaceId], references: [id])
  projects             Project[]
  runs                 ProjectRun[]

  @@map("IBOT_organization")
}

model Project {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  projectCode        String              @map("project_code") @db.VarChar(100)
  canonicalName      String              @map("canonical_name") @db.VarChar(240)
  description        String?             @db.Text
  objective          String?             @db.Text
  status             String              @map("status") @db.VarChar(30)
  visibility         String              @map("visibility") @db.VarChar(30)
  startedAt          DateTime?           @map("started_at") @db.Timestamptz
  closedAt           DateTime?           @map("closed_at") @db.Timestamptz
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  createdByPersonId  String?             @map("created_by_person_id") @db.Uuid
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  updatedByPersonId  String?             @map("updated_by_person_id") @db.Uuid
  rowVersion         BigInt              @default(1) @map("row_version")

  organization       Organization        @relation(fields: [organizationId], references: [id])
  runs               ProjectRun[]
  projectAssignments ProjectAssignment[]

  @@map("IBOT_project")
}

model ProjectRun {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  projectId              String                   @map("project_id") @db.Uuid
  runCode                String                   @map("run_code") @db.VarChar(100)
  displayName            String                   @map("display_name") @db.VarChar(260)
  description            String?                  @db.Text
  sequenceNo             Int                      @map("sequence_no")
  status                 String                   @map("status") @db.VarChar(30)
  visibility             String                   @map("visibility") @db.VarChar(30)
  targetParticipantCount Int?                     @map("target_participant_count")
  applicationOpenAt      DateTime?                @map("application_open_at") @db.Timestamptz
  applicationCloseAt     DateTime?                @map("application_close_at") @db.Timestamptz
  plannedStartAt         DateTime?                @map("planned_start_at") @db.Timestamptz
  plannedEndAt           DateTime?                @map("planned_end_at") @db.Timestamptz
  actualStartAt          DateTime?                @map("actual_start_at") @db.Timestamptz
  actualEndAt            DateTime?                @map("actual_end_at") @db.Timestamptz
  activeSetupVersionId   String?                  @map("active_setup_version_id") @db.Uuid
  copiedFromRunId        String?                  @map("copied_from_run_id") @db.Uuid
  blueprintVersionId     String?                  @map("blueprint_version_id") @db.Uuid
  publishedAt            DateTime?                @map("published_at") @db.Timestamptz
  closedAt               DateTime?                @map("closed_at") @db.Timestamptz
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  createdByPersonId      String?                  @map("created_by_person_id") @db.Uuid
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  updatedByPersonId      String?                  @map("updated_by_person_id") @db.Uuid
  rowVersion             BigInt                   @default(1) @map("row_version")

  project                Project                  @relation(fields: [projectId], references: [id])
  organization           Organization             @relation(fields: [organizationId], references: [id])
  setupVersions          ProjectRunSetupVersion[]
  runAssignments         RunAssignment[]
  runPhases               RunPhase[]
  runParticipations      RunParticipation[]

  @@map("IBOT_project_run")
}

model ProjectRunSetupVersion {
  id                         String     @id @default(uuid()) @db.Uuid
  organizationId             String     @map("organization_id") @db.Uuid
  projectRunId               String     @map("project_run_id") @db.Uuid
  versionNo                  Int        @map("version_no")
  status                     String     @map("status") @db.VarChar(30)
  entryPolicyJson            Json?      @map("entry_policy_json")
  participantFieldSchemaJson Json?      @map("participant_field_schema_json")
  handoverPolicyJson         Json?      @map("handover_policy_json")
  notificationPolicyJson     Json?      @map("notification_policy_json")
  configurationJson          Json?      @map("configuration_json")
  changeSummary              String?    @map("change_summary") @db.Text
  effectiveFrom              DateTime?  @map("effective_from") @db.Timestamptz
  supersedesVersionId        String?    @map("supersedes_version_id") @db.Uuid
  reviewedByPersonId         String?    @map("reviewed_by_person_id") @db.Uuid
  reviewedAt                 DateTime?  @map("reviewed_at") @db.Timestamptz
  approvedByPersonId         String?    @map("approved_by_person_id") @db.Uuid
  approvedAt                 DateTime?  @map("approved_at") @db.Timestamptz
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  createdByPersonId          String?    @map("created_by_person_id") @db.Uuid

  projectRun                 ProjectRun @relation(fields: [projectRunId], references: [id])

  @@map("IBOT_project_run_setup_version")
}

model ProjectAssignment {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  projectId             String    @map("project_id") @db.Uuid
  personId              String    @map("person_id") @db.Uuid
  workspaceMembershipId String?   @map("workspace_membership_id") @db.Uuid
  roleId                String    @map("role_id") @db.Uuid
  partySide             String    @map("party_side") @db.VarChar(20) // ORGANIZATION, OTTOBON
  status                String    @map("status") @db.VarChar(30)
  effectiveFrom         DateTime? @map("effective_from") @db.Timestamptz
  effectiveUntil        DateTime? @map("effective_until") @db.Timestamptz
  assignedByPersonId    String?   @map("assigned_by_person_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion            BigInt    @default(1) @map("row_version")

  project               Project   @relation(fields: [projectId], references: [id])
  person                Person    @relation(fields: [personId], references: [id])

  @@map("IBOT_project_assignment")
}

model RunAssignment {
  id                    String     @id @default(uuid()) @db.Uuid
  organizationId        String     @map("organization_id") @db.Uuid
  projectRunId          String     @map("project_run_id") @db.Uuid
  personId              String     @map("person_id") @db.Uuid
  workspaceMembershipId String?    @map("workspace_membership_id") @db.Uuid
  roleId                String     @map("role_id") @db.Uuid
  partySide             String     @map("party_side") @db.VarChar(20) // ORGANIZATION, OTTOBON
  status                String     @map("status") @db.VarChar(30)
  effectiveFrom         DateTime?  @map("effective_from") @db.Timestamptz
  effectiveUntil        DateTime?  @map("effective_until") @db.Timestamptz
  assignedByPersonId    String?    @map("assigned_by_person_id") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion            BigInt     @default(1) @map("row_version")

  projectRun            ProjectRun @relation(fields: [projectRunId], references: [id])
  person                Person     @relation(fields: [personId], references: [id])

  @@map("IBOT_run_assignment")
}

model RunPhase {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @map("organization_id") @db.Uuid
  projectRunId          String                  @map("project_run_id") @db.Uuid
  phaseType             String                  @map("phase_type") @db.VarChar(20) // IDENTIFY, BUILD, OPERATE, TRANSFER
  sequenceNo            Int                     @map("sequence_no")
  status                String                  @map("status") @db.VarChar(30)
  ownershipType         String                  @map("ownership_type") @db.VarChar(20) // ORGANIZATION, OTTOBON, SHARED
  capacity              Int?                    @map("capacity")
  plannedStartAt        DateTime?               @map("planned_start_at") @db.Timestamptz
  plannedEndAt          DateTime?               @map("planned_end_at") @db.Timestamptz
  actualStartAt         DateTime?               @map("actual_start_at") @db.Timestamptz
  actualEndAt           DateTime?               @map("actual_end_at") @db.Timestamptz
  activeConfigVersionId String?                 @map("active_config_version_id") @db.Uuid
  startedByPersonId     String?                 @map("started_by_person_id") @db.Uuid
  completedByPersonId   String?                 @map("completed_by_person_id") @db.Uuid
  holdReason            String?                 @map("hold_reason") @db.Text
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz
  createdByPersonId     String?                 @map("created_by_person_id") @db.Uuid
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  updatedByPersonId     String?                 @map("updated_by_person_id") @db.Uuid
  rowVersion            BigInt                  @default(1) @map("row_version")

  projectRun            ProjectRun              @relation(fields: [projectRunId], references: [id])
  configVersions        RunPhaseConfigVersion[]
  phaseAssignments      PhaseAssignment[]
  phaseParticipations   PhaseParticipation[]

  @@map("IBOT_run_phase")
}

model RunPhaseConfigVersion {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  runPhaseId              String    @map("run_phase_id") @db.Uuid
  versionNo               Int       @map("version_no")
  status                  String    @map("status") @db.VarChar(30)
  configJson              Json      @map("config_json")
  inputContractJson       Json?     @map("input_contract_json")
  completionRuleJson      Json?     @map("completion_rule_json")
  handoverEligibilityJson Json?     @map("handover_eligibility_json")
  changeSummary           String?   @map("change_summary") @db.Text
  effectiveFrom           DateTime? @map("effective_from") @db.Timestamptz
  supersedesVersionId     String?   @map("supersedes_version_id") @db.Uuid
  reviewedByPersonId      String?   @map("reviewed_by_person_id") @db.Uuid
  reviewedAt              DateTime? @map("reviewed_at") @db.Timestamptz
  publishedByPersonId     String?   @map("published_by_person_id") @db.Uuid
  publishedAt             DateTime? @map("published_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdByPersonId       String?   @map("created_by_person_id") @db.Uuid

  runPhase                RunPhase  @relation(fields: [runPhaseId], references: [id])

  @@map("IBOT_run_phase_config_version")
}

model PhaseAssignment {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  runPhaseId            String    @map("run_phase_id") @db.Uuid
  personId              String    @map("person_id") @db.Uuid
  workspaceMembershipId String?   @map("workspace_membership_id") @db.Uuid
  roleId                String    @map("role_id") @db.Uuid
  partySide             String    @map("party_side") @db.VarChar(20) // ORGANIZATION, OTTOBON
  status                String    @map("status") @db.VarChar(30)
  effectiveFrom         DateTime? @map("effective_from") @db.Timestamptz
  effectiveUntil        DateTime? @map("effective_until") @db.Timestamptz
  assignedByPersonId    String?   @map("assigned_by_person_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion            BigInt    @default(1) @map("row_version")

  runPhase              RunPhase  @relation(fields: [runPhaseId], references: [id])
  person                Person    @relation(fields: [personId], references: [id])

  @@map("IBOT_phase_assignment")
}

model RunParticipation {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  projectRunId         String                @map("project_run_id") @db.Uuid
  personId             String                @map("person_id") @db.Uuid
  status               String                @map("status") @db.VarChar(30)
  enrolledAt           DateTime              @default(now()) @map("enrolled_at") @db.Timestamptz
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion           BigInt                @default(1) @map("row_version")

  projectRun           ProjectRun            @relation(fields: [projectRunId], references: [id])
  person               Person                @relation(fields: [personId], references: [id])
  phaseParticipations  PhaseParticipation[]
  handoverParticipants HandoverParticipant[]

  @@map("IBOT_run_participation")
}

model PhaseParticipation {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  runPhaseId         String           @map("run_phase_id") @db.Uuid
  runParticipationId String           @map("run_participation_id") @db.Uuid
  personId           String           @map("person_id") @db.Uuid
  status             String           @map("status") @db.VarChar(30)
  intakeSourceType   String           @map("intake_source_type") @db.VarChar(40)
  intakeHandoverId   String?          @map("intake_handover_id") @db.Uuid
  enteredAt          DateTime         @default(now()) @map("entered_at") @db.Timestamptz
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion         BigInt           @default(1) @map("row_version")

  runPhase           RunPhase         @relation(fields: [runPhaseId], references: [id])
  runParticipation   RunParticipation @relation(fields: [runParticipationId], references: [id])
  person             Person           @relation(fields: [personId], references: [id])

  @@map("IBOT_phase_participation")
}

model Handover {
  id                  String                @id @default(uuid()) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  projectRunId        String                @map("project_run_id") @db.Uuid
  fromRunPhaseId      String                @map("from_run_phase_id") @db.Uuid
  toRunPhaseId        String                @map("to_run_phase_id") @db.Uuid
  status              String                @map("status") @db.VarChar(30)
  title               String?               @db.VarChar(240)
  reason              String?               @db.Text
  initiatedByPersonId String                @map("initiated_by_person_id") @db.Uuid
  acceptedByPersonId  String?               @map("accepted_by_person_id") @db.Uuid
  sentAt              DateTime?             @map("sent_at") @db.Timestamptz
  acceptedAt          DateTime?             @map("accepted_at") @db.Timestamptz
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion          BigInt                @default(1) @map("row_version")

  handoverParticipants HandoverParticipant[]

  @@map("IBOT_handover")
}

model HandoverParticipant {
  id                         String           @id @default(uuid()) @db.Uuid
  organizationId             String           @map("organization_id") @db.Uuid
  handoverId                 String           @map("handover_id") @db.Uuid
  runParticipationId         String           @map("run_participation_id") @db.Uuid
  sourcePhaseParticipationId String           @map("source_phase_participation_id") @db.Uuid
  targetPhaseParticipationId String?          @map("target_phase_participation_id") @db.Uuid
  validationStatus           String           @map("validation_status") @db.VarChar(30)
  status                     String           @map("status") @db.VarChar(30)
  selectedByPersonId         String           @map("selected_by_person_id") @db.Uuid
  createdAt                  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion                 BigInt           @default(1) @map("row_version")

  handover                   Handover         @relation(fields: [handoverId], references: [id])
  runParticipation           RunParticipation @relation(fields: [runParticipationId], references: [id])
  person                     Person           @relation(fields: [selectedByPersonId], references: [id])

  @@map("IBOT_handover_participant")
}
